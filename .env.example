# .env.local にコピーして値を入れる（.env.local は Git に入れない）

# ブラウザから使う値（Vercel にもこの2つを設定する）
# Supabase の Project Settings > API にある Project URL と anon（または publishable）キー
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 在庫の見せ方："exact"（正確な数）または "level"（段階だけ）。省略すると exact
# NEXT_PUBLIC_STOCK_DISPLAY_MODE=exact

# ---- ここから下は npm run db:setup 用。ブラウザに出さない。Vercel には設定しない ----
# Project Settings > API の service_role キー（絶対に NEXT_PUBLIC_ を付けない）
SUPABASE_SERVICE_ROLE_KEY=
# Connect ボタン > Connection string（Session pooler）。[YOUR-PASSWORD] をデータベースのパスワードに置き換える
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
